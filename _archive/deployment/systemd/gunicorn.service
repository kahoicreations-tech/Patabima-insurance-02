[Unit]
Description=Gunicorn daemon for PataBima Django
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/patabima/insurance-app
Environment=DJANGO_SETTINGS_MODULE=insurance.settings
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/patabima/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 insurance.wsgi:application
Restart=on-failure
RestartSec=5
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
