{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LogsAndSNS",
      "Effect": "Allow",
      "Action": [
        "logs:*",
        "SNS:*",
        "sms-voice:*",
        "iam:ListUsers",
        "sns:Publish"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PataBimaResources",
      "Effect": "Allow",
      "Action": [
        "iam:*",
        "lambda:*",
        "apigateway:*",
        "dynamodb:*",
        "cloudformation:*",
        "s3:*"
      ],
      "Resource": [
        "arn:aws:iam::313530061018:role/PataBima-*",
        "arn:aws:iam::313530061018:policy/PataBima-*",
        "arn:aws:lambda:us-east-1:313530061018:function:PataBima-*",
        "arn:aws:apigateway:us-east-1::/restapis*",
        "arn:aws:dynamodb:us-east-1:313530061018:table/PataBima-*",
        "arn:aws:cloudformation:us-east-1:313530061018:stack/PataBima-*",
        "arn:aws:s3:::patabima-*"
      ]
    },
    {
      "Sid": "SESEmailSending",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail",
        "ses:SendTemplatedEmail",
        "ses:SendBulkTemplatedEmail"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SESIdentityManagement",
      "Effect": "Allow",
      "Action": [
        "ses:VerifyEmailIdentity",
        "ses:VerifyDomainIdentity",
        "ses:VerifyEmailAddress",
        "ses:DeleteIdentity",
        "ses:GetIdentityVerificationAttributes",
        "ses:ListIdentities",
        "ses:ListVerifiedEmailAddresses",
        "ses:GetSendQuota",
        "ses:GetSendStatistics",
        "ses:GetAccountSendingEnabled"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SESConfigurationSets",
      "Effect": "Allow",
      "Action": [
        "ses:CreateConfigurationSet",
        "ses:DeleteConfigurationSet",
        "ses:DescribeConfigurationSet",
        "ses:ListConfigurationSets",
        "ses:PutConfigurationSetDeliveryOptions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SESSuppressListAndBounce",
      "Effect": "Allow",
      "Action": [
        "ses:PutSuppressedDestination",
        "ses:GetSuppressedDestination",
        "ses:DeleteSuppressedDestination",
        "ses:ListSuppressedDestinations",
        "ses:SetIdentityNotificationTopic",
        "ses:SetIdentityFeedbackForwardingEnabled"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SESProductionAccessRequest",
      "Effect": "Allow",
      "Action": [
        "ses:PutAccountDetails",
        "ses:GetAccount"
      ],
      "Resource": "*"
    }
  ]
}
