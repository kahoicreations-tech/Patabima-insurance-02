{
  "expo": {
    "name": "PataBima Agent",
    "slug": "patabima-agent",
    "version": "1.0.2",
    "orientation": "portrait",
    "jsEngine": "hermes",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF",
      "imageMode": "center"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/05038c89-0d3b-4bba-a357-c3fa6af17848"
    },
    "assetBundlePatterns": [
      "assets/fonts/**/*",
      "assets/icons/**/*",
      "assets/*.png",
      "assets/*.jpg"
    ],
    "extra": {
      "eas": {
        "projectId": "05038c89-0d3b-4bba-a357-c3fa6af17848"
      },
      "apiBaseUrl": "${EXPO_PUBLIC_API_BASE_URL}",
      "apiUrl": "${EXPO_PUBLIC_API_URL}"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.patabima.agent"
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D5222B",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "usesCleartextTraffic": true,
      "package": "com.patabima.agent",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "patabima.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "owner": "kahoikreations",
    "plugins": [
      "expo-secure-store"
    ],
    "runtimeVersion": "1.0.2"
  }
}
