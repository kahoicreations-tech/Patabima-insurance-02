{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["*"],
      "@screens/*": ["screens/*"],
      "@components/*": ["components/*"],
      "@contexts/*": ["contexts/*"],
      "@services/*": ["services/*"],
      "@constants/*": ["constants/*"],
      "@theme/*": ["theme/*"],
      "@utils/*": ["utils/*"],
      "@shared/*": ["shared/*"]
    },
    "types": [],
    "typeRoots": []
  }
}
