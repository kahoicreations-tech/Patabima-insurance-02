DEBUG=False
SECRET_KEY=replace_me
DJANGO_SETTINGS_MODULE=insurance-app.settings

# Database
DATABASE_URL=postgresql://patabima_user:strong_password@localhost/patabima_db

# Hosts & CORS
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com,exp://192.168.0.10:8081
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# AWS (optional)
AWS_PROFILE=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# Docs/Textract pipeline (Motor2/Motor3 document uploads)
# Note: The S3 bucket used for docs uploads may live in a DIFFERENT AWS account
# than your EC2/RDS deployment account. If you see S3 PUT 403 AccessDenied,
# verify `aws sts get-caller-identity` matches the bucket-owner account.
S3_BUCKET=
S3_PREFIX=uploads
SQS_QUEUE_URL=
RESULTS_S3_BUCKET=
RESULTS_S3_PREFIX=textract-results
PRESIGN_EXPIRES_SEC=600
MAX_UPLOAD_MB=15

# AWS SES Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production with AWS SES, use: django_ses.SESBackend
AWS_SES_REGION_NAME=us-east-1
DEFAULT_FROM_EMAIL=noreply@patabima.co.ke
SERVER_EMAIL=noreply@patabima.co.ke
AWS_SES_AUTO_THROTTLE=0.5
ADMIN_EMAIL=admin@patabima.co.ke

# Payments (optional)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Copy to .env and adjust values
# PostgreSQL connection for Django
DATABASE_URL=postgresql://patabima_user:StrongPass123!@127.0.0.1:5432/patabima_insurance

# Optional: services backend URL if used elsewhere
SERVICES_BACKEND_BASE_URL=http://127.0.0.1:8001
