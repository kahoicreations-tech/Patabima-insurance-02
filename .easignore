# EAS Build Ignore File

# Files and directories listed here will be excluded from EAS builds

# Video files - exclude by default to keep archive small
# Keep our splash animation explicitly

*.mp4
*.mov
*.avi
*.mkv
*.webm
assets/videos/

# Keep the splash animation used by the app
!frontend/assets/Splash Screen Animation_V2.mp4

# Documentation - not needed in build

docs/
\*.md
!README.md

# Archive and backup files

\_archive/
_.zip
_.tar.gz
\*.backup
insurance-app-update.tar.gz

# Development and testing

tests/
_.test.js
_.test.ts
**tests**/

# AWS deployment files (not needed for mobile app build)

aws-config/
deployment/
infrastructure/
lambda_build/
lambda-deployed/
amplify/
docker-compose.yml
Dockerfile

# Backend Django app (not needed for mobile build)

insurance-app/
backend/
.venv/
venv/

# Frontend build artifacts and dependencies (CRITICAL - 400+ MB)
frontend/node_modules/
frontend/venv/
frontend/.venv/
frontend/dist/
frontend/build/
frontend/android/
frontend/ios/
frontend/.expo/

# Local development tools

LocalPilotMCP/
mcp-servers/

# Scripts (not needed in production app)

scripts/

# Git and IDE

.git/
.github/
.vscode/

# Environment files (handled separately)

.env.\*
!.env.production

# Build artifacts

out/
dist/
build/
_.apk
_.aab
\*.ipa

# Unnecessary data files at repository root only (keep frontend/data)

/data/**
# Ensure RN static data is included
!frontend/data/**

# Large design and media files

_.psd
_.sketch
_.fig
_.xd
\*.pdf
!app.json

# Temporary files

tmp/
temp/
_.tmp
.DS_Store
Thumbs.db
_.log
\*.cache
.cache/

# Source files (only compiled frontend needed)

src/
